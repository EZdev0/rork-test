{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Expo iOS Simulator",
            "type": "js-debug",
            "request": "attach",
            "port": 9221,
            "address": "localhost",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "webRoot": "${workspaceFolder}",
            "timeout": 30000
        },
        {
            "name": "Expo Android Emulator",
            "type": "js-debug",
            "request": "attach",
            "port": 9222,
            "address": "localhost",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "webRoot": "${workspaceFolder}",
            "timeout": 30000
        },
        {
            "name": "Expo Web Browser",
            "type": "chrome",
            "request": "attach",
            "port": 9223,
            "url": "http://localhost:8081",
            "webRoot": "${workspaceFolder}",
            "timeout": 30000
        },
        {
            "name": "Attach to Expo (Auto)",
            "type": "js-debug",
            "request": "attach",
            "port": 9224,
            "address": "localhost",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "webRoot": "${workspaceFolder}",
            "timeout": 30000
        }
    ]
}
